{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Studio",
  "version": "0.1.0",
  "identifier": "studio.voicestudio.app",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @voice-studio/studio",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace @voice-studio/studio",
    "frontendDist": "../../studio/dist"
  },
  "app": {
    "windows": [
      { "title": "Voice Studio", "width": 1240, "height": 850, "minWidth": 760, "minHeight": 620 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Music",
    "shortDescription": "Private reference-voice synthesis",
    "copyright": "Copyright 2026 Voice Studio contributors",
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
