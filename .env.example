# Copy to .env locally. Never commit configured credentials or voice recordings.
VOICE_MODE=local
VOICE_DATA_DIR=./data
VOICE_MODEL_DIR=./models
VOICE_BIND_HOST=127.0.0.1
VOICE_PORT=8765
# Leave empty for a fresh random key at each CLI launch. Configured keys also expire.
# To replace an expired configured key: python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_LOCAL_TOKEN=
# Fixed lifetime from first registration, not inactivity. 60–86400 seconds; no unlimited value.
VOICE_LOCAL_TOKEN_TTL_SECONDS=28800
VOICE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Automated single-sandbox setup: voice cloud setup --deployment my-studio --source .
# It bootstraps hosted_daytona_single credentials; do not copy runtime keys into this file.
# The manual hosted_external profile requires PostgreSQL/S3 and an owner password hash.
# VOICE_MODE=hosted
# VOICE_DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require
# VOICE_S3_ENDPOINT=https://your-object-storage-endpoint
# VOICE_S3_BUCKET=voice-studio-private
# VOICE_S3_ACCESS_KEY=
# VOICE_S3_SECRET_KEY=
# VOICE_OWNER_PASSWORD_HASH= # voice password-hash
# VOICE_SESSION_SECRET= # at least 32 random characters
# VOICE_DAYTONA_API_KEY=
# VOICE_DAYTONA_API_URL=https://app.daytona.io/api
# VOICE_DAYTONA_CONTROLLER_SNAPSHOT=
# VOICE_DAYTONA_WORKER_SNAPSHOT=
# VOICE_DAYTONA_SECRET_NAMES={} # environment variable name -> Daytona secret name
# VOICE_DEPLOYMENT_ID=voice-studio
# VOICE_MONTHLY_BUDGET_USD=50
# Model/GPU availability is verified before selection. CPU is the default.
VOICE_DEVICE=cpu
VOICE_WORKER_CPU=4
VOICE_WORKER_MEMORY_GIB=8
VOICE_CONTROLLER_IDLE_SECONDS=600
VOICE_JOB_TIMEOUT_SECONDS=900

VOICE_CPU_THREADS=4
VOICE_LOCAL_ENGINE_IDLE_SECONDS=300
