# Use Daytona secret references, not this file, for live credentials.
# Shared controller/worker durable state, independent of Daytona sandbox storage:
VOICE_DATABASE_URL=postgresql+psycopg://REPLACE@HOST/voice?sslmode=require
VOICE_S3_BUCKET=REPLACE
VOICE_S3_ENDPOINT=https://REPLACE
VOICE_S3_REGION=us-east-1
VOICE_S3_ACCESS_KEY=REPLACE
VOICE_S3_SECRET_KEY=REPLACE
# Controller only:
VOICE_OWNER_PASSWORD_HASH=REPLACE
VOICE_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
VOICE_DAYTONA_API_KEY=REPLACE
VOICE_DAYTONA_WORKER_SNAPSHOT=REPLACE_WITH_QUALIFIED_IMMUTABLE_SNAPSHOT_NAME
# Launcher only:
VOICE_DAYTONA_CONTROLLER_SNAPSHOT=REPLACE_WITH_QUALIFIED_IMMUTABLE_SNAPSHOT_NAME
VOICE_DAYTONA_SECRET_NAMES={"VOICE_DATABASE_URL":"voice-postgres","VOICE_S3_BUCKET":"voice-s3-bucket","VOICE_S3_ENDPOINT":"voice-s3-endpoint","VOICE_S3_REGION":"voice-s3-region","VOICE_S3_ACCESS_KEY":"voice-s3-access","VOICE_S3_SECRET_KEY":"voice-s3-secret","VOICE_OWNER_PASSWORD_HASH":"voice-owner-hash","VOICE_SESSION_SECRET":"voice-session-secret","VOICE_DAYTONA_API_KEY":"voice-daytona-api","VOICE_DAYTONA_WORKER_SNAPSHOT":"voice-worker-snapshot"}
VOICE_DEVICE=cpu
VOICE_WORKER_CPU=4
VOICE_WORKER_MEMORY_GIB=8
VOICE_WORKER_DISK_GIB=10
VOICE_CONTROLLER_IDLE_SECONDS=600
VOICE_MONTHLY_BUDGET_USD=50
