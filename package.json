{
  "name": "voice-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/studio",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @voice-studio/studio",
    "build": "npm run build --workspace @voice-studio/studio",
    "typecheck": "npm run typecheck --workspace @voice-studio/studio",
    "test": "npm run test --workspace @voice-studio/studio",
    "test:e2e": "playwright test",
    "desktop:dev": "npm run dev --workspace @voice-studio/desktop",
    "desktop:build": "npm run build --workspace @voice-studio/desktop",
    "client:generate": "openapi-typescript contracts/openapi.json -o apps/studio/src/api.generated.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.51.0",
    "openapi-typescript": "^7.6.1",
    "vite": "8.3.4"
  },
  "overrides": {
    "vite": "$vite"
  }
}
